  "narrative": {
    "northStar": "Selge sinine töölaud",
    "overview": "Tehisabiline ühendab tuttava tänapäevase AI-teenuse veebilehe selge, rahuliku lugemiskeskkonnaga. Valge pind ja tume tekst hoiavad pika eestikeelse sisu loetavana; erk sinine märgib tegevusi ja olulisemaid seoseid. Host Grotesk annab pealkirjadele iseloomu, Hanken Grotesk hoiab põhiteksti avatud ja loetavana.\n\nÜhine raamistik teenindab ettevõtteid, arendajaid, huvilisi ja rahastajaid: lihtne selgitus ees, tehniline tõendus järgmise sammuna. T-logo ja sinine on püsivad identiteedivalikud.",
    "keyCharacteristics": ["Valge lugemispind ja selge sinine aktsent", "Suured tihedad pealkirjad, rahulik põhitekst", "Peened piirjooned ja mõõdukas pinnakõrgendus", "Liikumine on piiratud, kasutaja eelistust arvestav"],
    "rules": [
      { "name": "The Blue-For-Action Rule", "body": "Hoia tugev brändisinine tegevustel ja tähenduslikel esiletõstmistel; suurte lugemispindade taust jääb heledaks.", "section": "colors" },
      { "name": "The Two-Font Rule", "body": "Kasuta Host Groteski pealkirjades ja Hanken Groteski tekstis; JetBrains Mono jääb koodinäidetele.", "section": "typography" }
    ],
    "dos": ["Do hoia lugemispinnad heledad ning kasuta sinist selgelt eristatavate tegevuste ja fookuse jaoks.", "Do säilita Host Grotesk / Hanken Grotesk rollijaotus ning olemasolevad skaleeruvad suurused.", "Do järgi laiuseid 900/980/1000px vastavalt paigutuse, päise ja kolmeveerulise võrgu vajadusele.", "Do säilita klaviatuurifookus ja `prefers-reduced-motion` toetus."],
    "donts": ["Don't kasuta süsteemi üldise alusena tumedat hacker-teemat, rohelist koodiekraani ega loetavust vähendavat tumedat pinda.", "Don't paiguta mobiilivaates dekoratiivset ribbonit päise või pealkirja taha.", "Don't pane hero-demo näidet lõputult korduma: see on ühekordne sissejuhatus, mille saab soovi korral uuesti käivitada."]
  }

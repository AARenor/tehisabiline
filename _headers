/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://ai.tehisabiline.ee; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), midi=(), gyroscope=(), magnetometer=(), accelerometer=()
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/css/pages/*
  Cache-Control: public, max-age=31536000, immutable
/site.css
  Cache-Control: public, max-age=31536000, immutable
/site.js
  Cache-Control: public, max-age=31536000, immutable
/assistant.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/assistant.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/assets/js/roi-calculator.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/hero-demo.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/plates/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/icons.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/downloads/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/assets/downloads/*.xlsx
  Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Robots-Tag: noindex
/feed.json
  Content-Type: application/feed+json; charset=utf-8
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  X-Robots-Tag: noindex
/llms.txt
  X-Robots-Tag: noindex
/llms-full.txt
  X-Robots-Tag: noindex
/sitemap.xml
  X-Robots-Tag: noindex
/entitymap.json
  X-Robots-Tag: noindex
  Content-Type: application/json; charset=utf-8
/humans.txt
  X-Robots-Tag: noindex
  Content-Type: text/plain; charset=utf-8
